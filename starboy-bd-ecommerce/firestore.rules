rules_version = '2';

// =============================================================================
// STARBOY BD — Firestore Security Rules
// =============================================================================
// HOW TO APPLY:
//   1. Go to https://console.firebase.google.com
//   2. Pick your project (dg-hub-841e8)
//   3. Build → Firestore Database → Rules tab
//   4. Replace everything with the contents of this file
//   5. Click "Publish"
//
// NOTE ON THIS APP'S AUTH MODEL:
//   This project does NOT use Firebase Authentication — it manages accounts in
//   the `users` collection from the browser. That means request.auth is always
//   null, so we CANNOT use auth-based rules. The rules below therefore allow the
//   client to read/write the collections the app needs.
//
//   ⚠️ SECURITY TRADE-OFF: Because there is no server-side auth, these rules are
//   permissive (any visitor's browser can write). This is acceptable for a small
//   store launch, but anyone technical could write junk data. For real
//   protection later, migrate auth to Firebase Authentication and tighten the
//   write rules (see the commented "HARDENED" example at the bottom).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Publicly readable catalog/content (everyone can read) ----
    match /products/{doc}     { allow read: if true; allow write: if true; }
    match /categories/{doc}    { allow read: if true; allow write: if true; }
    match /settings/{doc}      { allow read: if true; allow write: if true; }
    match /stats/{doc}         { allow read: if true; allow write: if true; }
    match /announcements/{doc} { allow read: if true; allow write: if true; }
    match /testimonials/{doc}  { allow read: if true; allow write: if true; }
    match /reviews/{doc}       { allow read: if true; allow write: if true; }

    // ---- User-generated / account data ----
    match /users/{doc}         { allow read: if true; allow write: if true; }
    match /carts/{doc}         { allow read: if true; allow write: if true; }
    match /wishlists/{doc}     { allow read: if true; allow write: if true; }
    match /orders/{doc}        { allow read: if true; allow write: if true; }
    match /chat_messages/{doc} { allow read: if true; allow write: if true; }
    match /page_views/{doc}    { allow read: if true; allow write: if true; }

    // ---- Catch-all for any other collection the app uses ----
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

